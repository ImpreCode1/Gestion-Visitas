generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  name          String
  email         String         @unique
  phone         String?
  position      String?
  department    String?
  role          String
  tipoaprobador TipoAprobador? @default(null)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relaciones
  visitasRegistradas    Visita[]              @relation("VisitasGerente")
  historialAprobaciones HistorialAprobacion[] @relation("HistorialAprobaciones")
  facturasRevisadas     Factura[]             @relation("FacturasRevisadas")

  @@map("user")
}

model Visita {
  id        Int  @id @default(autoincrement())
  gerenteId Int
  gerente   User @relation("VisitasGerente", fields: [gerenteId], references: [id])

  // Datos del cliente
  clienteCodigo String
  cliente       String

  direccion     String
  ciudad        String?
  pais          String?
  contacto      String?
  telefono      String?
  personaVisita String?

  // Datos de la visita
  tipoVisita   TipoVisita @default(por_definir)
  otroTipo     String?
  motivo       String       // breve descripción del motivo ("reunión con cliente", "almuerzo", etc.)
  descripcion  String?      // detalle adicional de la visita
  proposito    String?      // objetivo comercial o técnico
  oportunidadCRM String?    // vinculación con CRM

  ciudad_origen  String
  fecha_ida      DateTime
  fecha_regreso  DateTime
  lugar          String?
  requiereAvion  Boolean      @default(false)
  estado         EstadoVisita @default(pendiente)
  area           String       @default("")
  gastos_viaje   String
  fondos_fabrica Boolean      @default(false)

  // Gastos asociados
  tiquetes       Float?
  alojamiento    Float?
  alimentacion   Float?
  otros_gastos   Float?

  // Relaciones
  facturas     Factura?
  aprobaciones Aprobacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("visita")
}


model Factura {
  id          Int              @id @default(autoincrement())
  visitaId    Int              @unique // 👈 asegura que solo exista un registro por visita
  visita      Visita           @relation(fields: [visitaId], references: [id])
  archivos    ArchivoFactura[] // 👈 varios archivos dentro del mismo grupo
  descripcion String?
  montoTotal  Float?
  createdAt   DateTime         @default(now())

  estado             EstadoFactura @default(pendiente)
  revisadoPorId      Int?
  revisadoPor        User?         @relation("FacturasRevisadas", fields: [revisadoPorId], references: [id])
  fechaRevision      DateTime?
  comentarioRevision String?

  @@map("factura")
}

model ArchivoFactura {
  id        Int      @id @default(autoincrement())
  facturaId Int
  factura   Factura  @relation(fields: [facturaId], references: [id])
  nombre    String // nombre original del archivo
  url       String // ruta donde quedó guardado (S3, disco, etc.)
  createdAt DateTime @default(now())

  @@map("archivofactura")
}

model Aprobacion {
  id       Int    @id @default(autoincrement())
  visitaId Int
  visita   Visita @relation(fields: [visitaId], references: [id])

  rol        RolAprobacion
  estado     EstadoAprobacion @default(pendiente)
  comentario String?
  fecha      DateTime         @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  historial HistorialAprobacion[]

  @@map("aprobacion")
}

model HistorialAprobacion {
  id             Int              @id @default(autoincrement())
  aprobacionId   Int
  aprobacion     Aprobacion       @relation(fields: [aprobacionId], references: [id])
  usuarioId      Int
  usuario        User             @relation("HistorialAprobaciones", fields: [usuarioId], references: [id])
  estadoAnterior EstadoAprobacion
  estadoNuevo    EstadoAprobacion
  comentario     String?
  fecha          DateTime         @default(now())

  @@map("historial_aprobacion")
}

enum EstadoVisita {
  pendiente
  aprobada
  rechazada
  en_legalizacion
  completada
}

enum EstadoFactura {
  pendiente
  aprobada
  rechazada
}

enum EstadoAprobacion {
  pendiente
  aprobado
  rechazado
}

enum TipoAprobador {
  null
  suministros
  adquisiciones
}

enum RolAprobacion {
  vicepresidencia
  tiquetes
  transporte
  notas_credito
}

enum TipoVisita {
  por_definir
  comercial
  tecnica
  capacitacion
  auditoria
  otros
}